root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.go]
indent_style = tab
indent_size = 4

[Makefile*]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.proto]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off


